{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/madowaku/noxsum-lab/schemas/noxsum_level_v1.schema.json",
  "title": "NOXSUM Canonical Level v1",
  "type": "object",
  "required": [
    "schema_version",
    "id",
    "source",
    "board",
    "inventory",
    "solution",
    "observations",
    "metrics",
    "curation"
  ],
  "properties": {
    "schema_version": {
      "const": "noxsum.level.v1"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string"
    },
    "source": {
      "type": "object",
      "required": ["kind", "source_id"],
      "properties": {
        "kind": {
          "enum": ["generated", "imported", "handmade", "mutated"]
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "type": ["string", "null"]
        },
        "repo": {
          "type": ["string", "null"]
        },
        "ref": {
          "type": ["string", "null"]
        },
        "path": {
          "type": ["string", "null"]
        },
        "seed": {
          "type": ["integer", "null"]
        }
      },
      "additionalProperties": true
    },
    "board": {
      "type": "object",
      "required": ["width", "height"],
      "properties": {
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "mask": {
          "type": ["array", "null"]
        }
      },
      "additionalProperties": true
    },
    "inventory": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    },
    "solution": {
      "type": "object",
      "required": ["placements"],
      "properties": {
        "placements": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["piece", "cell"],
            "properties": {
              "piece": {
                "type": "string"
              },
              "cell": {
                "type": "string"
              },
              "orientation": {
                "type": ["integer", "string", "null"]
              }
            },
            "additionalProperties": true
          }
        },
        "lights": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": true
    },
    "mechanics": {
      "type": "object",
      "additionalProperties": true
    },
    "observations": {
      "type": "array"
    },
    "annotations": {
      "type": "object",
      "additionalProperties": true
    },
    "metrics": {
      "type": "object",
      "additionalProperties": {
        "type": ["number", "integer", "boolean", "string", "null"]
      }
    },
    "curation": {
      "type": "object",
      "required": ["bucket", "tags"],
      "properties": {
        "bucket": {
          "enum": ["UNREVIEWED", "FLOW", "AHA", "BOTH", "REJECT"]
        },
        "target": {
          "enum": ["NONE", "MOBILE", "STEAM", "BOTH"]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": true
}
